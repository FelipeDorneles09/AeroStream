# ==============================================================================
# AeroStream - Environment Configuration Template
# ==============================================================================

# Application & Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL & TimescaleDB
DB_HOST=localhost
DB_PORT=5432
DB_USER=aerostream
DB_PASSWORD=aerostream_secret
DB_NAME=aerostream_db
DB_SSL=false

# Redis (Hot State & Streams)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Simulator Configurations
SIMULATOR_DRONE_COUNT=5
SIMULATOR_INTERVAL_MS=1000
SIMULATOR_ANOMALY_PROBABILITY=0.05
API_INGESTION_URL=http://localhost:3000/api/v1/telemetry
