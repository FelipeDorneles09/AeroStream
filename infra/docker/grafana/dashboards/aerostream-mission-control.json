{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "AeroStream Fleet Telemetry Ingestion Overview",
      "type": "row"
    },
    {
      "title": "Current Ingestion Rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(aerostream_telemetry_ingested_total[1m]))",
          "legendFormat": "Telemetry Points / sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          },
          "unit": "reqps"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "title": "Active Live Web Dashboards (SSE)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "aerostream_active_sse_connections",
          "legendFormat": "Subscribers",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "locale"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "title": "Ingestion Latency p95 / p99 (SLA: < 150ms)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(aerostream_telemetry_ingestion_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p95 Latency (ms)",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(aerostream_telemetry_ingestion_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p99 Latency (ms)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 150 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "Pipeline Storage & Buffer Latencies",
      "type": "row"
    },
    {
      "title": "Redis Streams Publish vs TimescaleDB Insert Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 8 },
      "id": 4,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(aerostream_redis_stream_publish_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "Redis Stream Publish p95 (ms)",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(aerostream_db_insert_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "TimescaleDB Insert p95 (ms)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "title": "Domain Safety Violations & Alerts",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 8 },
      "id": 5,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (alert_type) (aerostream_telemetry_alerts_total)",
          "legendFormat": "{{alert_type}}",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "Node.js Process Health & Resources",
      "type": "row"
    },
    {
      "title": "Memory Heap Usage",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "id": 6,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "aerostream_nodejs_heap_size_used_bytes",
          "legendFormat": "Used Heap",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "aerostream_nodejs_heap_size_total_bytes",
          "legendFormat": "Total Heap Allocated",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20
          }
        }
      }
    },
    {
      "title": "HTTP Requests by Status Code",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "id": 7,
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum by (status_code) (rate(aerostream_http_requests_total[1m]))",
          "legendFormat": "HTTP {{status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["aerostream", "telemetry", "drones", "observability"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["1s", "5s", "10s", "30s", "1m"]
  },
  "timezone": "browser",
  "title": "AeroStream: Mission Control & Fleet Observability",
